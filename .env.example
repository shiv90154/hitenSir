# PostgreSQL connection string (Neon, Supabase, RDS, or local Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/bharattrip?schema=public"

# 32+ character random string used to encrypt the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Admin login. Read by `npm run seed:admin` (scripts/seed-admin.ts) — the
# actual login always checks a bcrypt hash stored in the database, never
# this plaintext value directly, so re-run seed:admin after changing this.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Transactional email (Resend) for new-enquiry notifications.
RESEND_API_KEY=""
ENQUIRY_NOTIFY_EMAIL=""

# Base URL of the deployed site, used for sitemap/canonical/OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
